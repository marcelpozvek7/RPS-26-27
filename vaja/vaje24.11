from flask import Flask, render_template, request
import random

app = Flask(__name__)

@app.route("/")
def hello_world():
    return render_template("index.html")

@app.route("/ljubezn", methods=["POST"])
def love_calc():
    i1 = request.form["ime1"]
    i2 = request.form["ime2"]
    pr = 0

    if i1.strip().lower() == "marcel" or i2.strip().lower() == "marcel":
        pr = random.randint(90, 100)
    elif i1.strip().lower() == "žan" or i2.strip().lower() == "žan":
        pr = random.randint(0, 10)
    else:
        pr = random.randint(0, 100)

    if pr < 30:
        komentar = "Pozabi"
    elif pr < 70:
        komentar = "Morda"
    else:
        komentar = "Poroka!"

    return render_template("index.html", ime1=i1, ime2=i2, p=pr, komentar=komentar)

app.run(debug=True)
